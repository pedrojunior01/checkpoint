# Credenciais do Google Cloud Console para o provedor Google Drive.
# 
# Como obter:
#   1. Acesse https://console.cloud.google.com/
#   2. Crie um projeto e ative a "Google Drive API"
#   3. Em "Credenciais" > "Criar ID do cliente OAuth"
#      - Tipo: "Aplicativo para Computador" (Desktop App)
#   4. Copie o client_id e client_secret abaixo
#
# NUNCA versione o arquivo .env com valores reais!
# Este arquivo (.env.example) é apenas um template seguro.

SAVEVAULT_GOOGLE_CLIENT_ID=SEU_CLIENT_ID_AQUI.apps.googleusercontent.com
SAVEVAULT_GOOGLE_CLIENT_SECRET=GOCSPX-SEU_CLIENT_SECRET_AQUI
