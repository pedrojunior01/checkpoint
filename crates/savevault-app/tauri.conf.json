{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SaveVault",
  "version": "0.1.0",
  "identifier": "com.savevault.desktop",
  "build": {
    "frontendDist": "./ui/frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SaveVault — DEV-UI-01",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
