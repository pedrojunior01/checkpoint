{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SaveVault",
  "version": "0.1.0",
  "identifier": "com.savevault.desktop",
  "build": {
    "frontendDist": "./ui/frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SaveVault",
        "width": 1040,
        "height": 720,
        "minWidth": 860,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://shared.cloudflare.steamstatic.com https://cdn.cloudflare.steamstatic.com https://steamcdn-a.akamaihd.net; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self';"
    },
    "trayIcon": {
      "id": "savevault-tray",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
